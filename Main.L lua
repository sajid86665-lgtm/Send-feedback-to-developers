require "import"
import "android.widget.*"
import "android.view.*"
import "android.graphics.Color"
import "android.content.DialogInterface"
import "android.content.Intent"
import "android.net.Uri"
import "android.os.Handler"

local windows = {}
local dlg = nil
local navStack = {}

windows[1] = {
  title = "feedback to developers",
  elements = {
    { type = "title" },
    { type = "textview", text = "with this useful utility you can easily give the feedback to developers" },
    { type = "edittext", hint = "enter full name" },
    { type = "combobox", label = "choose your gender ", options = "male,female,other" },
    { type = "combobox", label = "send feedback via", options = "WhatsApp,Telegram" },
    { type = "checkbox", label = "I have Telegram" },
    { type = "edittext", hint = "enter your telegram user name" },
    { type = "edittext", hint = "Enter your WhatsApp mobile number" },
    { type = "edittext", hint = "Enter your feedback" },
    { type = "button", label = "Send feedback", targetId = nil },
    { type = "button", label = "Back", targetId = 0 },
  }
}

local showScreen
showScreen = function(id, isBack)
  local winData = windows[id]
  if not winData then return end
  if not isBack then
    table.insert(navStack, id)
  end
  local layout = {
    LinearLayout,
    orientation = "vertical",
    layout_width = "fill",
    layout_height = "fill",
    backgroundColor = Color.parseColor("#121212"),
    padding = "16dp",
    {
      ScrollView,
      layout_width = "fill",
      layout_height = "fill",
      fillViewport = true,
      {
        LinearLayout,
        id = "container",
        orientation = "vertical",
        layout_width = "fill",
        layout_height = "wrap",
      }
    }
  }
  if dlg then dlg.dismiss() end
  dlg = LuaDialog(service)
  dlg.View = loadlayout(layout)
  
  local nameEditText = nil
  local genderSpinner = nil
  local mediumSpinner = nil
  local telegramCheckbox = nil
  local telegramEditText = nil
  local whatsappEditText = nil
  local feedbackEditText = nil

  for _, elem in ipairs(winData.elements) do
    if elem.type == "title" then
      local t = TextView(service)
      t.setText(winData.title)
      t.setTextSize(20)
      t.setTextColor(Color.WHITE)
      t.setPadding(10, 10, 10, 10)
      container.addView(t)
    elseif elem.type == "button" then
      local b = Button(service)
      b.setText(elem.label)
      if elem.label == "Send feedback" then
        b.setOnClickListener(function()
          local nameVal = nameEditText and nameEditText.getText().toString() or ""
          local genderVal = genderSpinner and genderSpinner.getSelectedItem() or ""
          local mediumVal = mediumSpinner and mediumSpinner.getSelectedItem() or "WhatsApp"
          local hasTelegram = telegramCheckbox and telegramCheckbox.isChecked() or false
          local telegramVal = telegramEditText and telegramEditText.getText().toString() or ""
          local whatsappVal = whatsappEditText and whatsappEditText.getText().toString() or ""
          local feedbackVal = feedbackEditText and feedbackEditText.getText().toString() or ""

          if nameVal == "" then
            Toast.makeText(service, "Please enter your full name", Toast.LENGTH_SHORT).show()
            return
          end
          if hasTelegram and telegramVal == "" then
            Toast.makeText(service, "Please enter your telegram user name", Toast.LENGTH_SHORT).show()
            return
          end
          if whatsappVal == "" then
            Toast.makeText(service, "Please enter your WhatsApp mobile number", Toast.LENGTH_SHORT).show()
            return
          end
          if feedbackVal == "" then
            Toast.makeText(service, "Please enter your feedback", Toast.LENGTH_SHORT).show()
            return
          end

          local msg = "NEW FEEDBACK RECEIVED\n\n\n" ..
                      "Name: " .. nameVal .. "\n\n\n" ..
                      "Gender: " .. tostring(genderVal) .. "\n\n\n"

          if hasTelegram and telegramVal ~= "" then
            msg = msg .. "Telegram: " .. telegramVal .. "\n\n\n"
          end

          msg = msg .. "WhatsApp: " .. whatsappVal .. "\n\n\n" ..
                      "Feedback:\n" .. feedbackVal

          if dlg then dlg.dismiss() end

          pcall(function()
            local intent
            if tostring(mediumVal) == "Telegram" then
              local tgUser = "mezabalibot"
              if telegramVal ~= "" then
                tgUser = telegramVal
              end
              intent = Intent(Intent.ACTION_VIEW, Uri.parse("tg://resolve?domain=" .. tgUser))
            else
              local url = "https://api.whatsapp.com/send?phone=9118141191&text=" .. Uri.encode(msg)
              intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            end
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            service.startActivity(intent)
          end)
        end)
      else
        b.setOnClickListener(function()
          if elem.targetId == 0 then
            if #navStack > 1 then
              table.remove(navStack)
              local prevId = navStack[#navStack]
              table.remove(navStack)
              showScreen(prevId, false)
            else
              if dlg then dlg.dismiss() end
            end
          elseif elem.targetId and windows[elem.targetId] then
            showScreen(elem.targetId, false)
          end
        end)
      end
      container.addView(b)
    elseif elem.type == "clickable" then
      local l = LinearLayout(service)
      l.setOrientation(LinearLayout.VERTICAL)
      l.setPadding(20, 20, 20, 20)
      l.setClickable(true)
      l.setFocusable(true)
      local t = TextView(service)
      t.setText(elem.label)
      t.setTextColor(Color.WHITE)
      l.addView(t)
      l.setOnClickListener(function()
        if elem.targetId == 0 then
          if #navStack > 1 then
            table.remove(navStack)
            local prevId = navStack[#navStack]
            table.remove(navStack)
            showScreen(prevId, false)
          else
            if dlg then dlg.dismiss() end
          end
        elseif elem.targetId and windows[elem.targetId] then
          showScreen(elem.targetId, false)
        end
      end)
      container.addView(l)
    elseif elem.type == "edittext" then
      local e = EditText(service)
      if elem.hint and elem.hint ~= "" then
        e.setHint(elem.hint)
      end
      e.setTextColor(Color.WHITE)
      container.addView(e)
      
      if elem.hint == "enter full name" then
        nameEditText = e
      elseif elem.hint == "enter your telegram user name" then
        telegramEditText = e
        e.setVisibility(View.GONE)
      elseif elem.hint == "Enter your WhatsApp mobile number" then
        whatsappEditText = e
      elseif elem.hint == "Enter your feedback" then
        feedbackEditText = e
      end
    elseif elem.type == "checkbox" then
      local c = CheckBox(service)
      c.setText(elem.label)
      c.setTextColor(Color.WHITE)
      container.addView(c)
      
      if elem.label == "I have Telegram" then
        telegramCheckbox = c
        c.setOnCheckedChangeListener(CompoundButton.OnCheckedChangeListener{
          onCheckedChanged = function(buttonView, isChecked)
            if telegramEditText then
              if isChecked then
                telegramEditText.setVisibility(View.VISIBLE)
              else
                telegramEditText.setVisibility(View.GONE)
              end
            end
          end
        })
      end
    elseif elem.type == "textview" then
      local t = TextView(service)
      t.setText(elem.text)
      t.setTextColor(Color.WHITE)
      container.addView(t)
    elseif elem.type == "slider" then
      if elem.label and elem.label ~= "" then
        local t = TextView(service)
        t.setText(elem.label)
        t.setTextColor(Color.WHITE)
        container.addView(t)
      end
      local s = SeekBar(service)
      s.setMax(100)
      container.addView(s)
    elseif elem.type == "linkbutton" then
      local b = Button(service)
      b.setText(elem.label)
      b.setOnClickListener(function()
        if dlg then dlg.dismiss() end
        pcall(function()
          local intent = Intent(Intent.ACTION_VIEW, Uri.parse(elem.url))
          intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
          service.startActivity(intent)
        end)
      end)
      container.addView(b)
    elseif elem.type == "combobox" then
      if elem.label and elem.label ~= "" then
        local t = TextView(service)
        t.setText(elem.label)
        t.setTextColor(Color.WHITE)
        container.addView(t)
      end
      local s = Spinner(service)
      local opts = {}
      for opt in string.gmatch(elem.options or "", "[^,]+") do
        local trimmed = opt:match("^%s*(.-)%s*$")
        if trimmed ~= "" then table.insert(opts, trimmed) end
      end
      if #opts == 0 then table.insert(opts, "Option 1") end
      local adapter = ArrayAdapter(service, android.R.layout.simple_spinner_item, opts)
      adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
      s.setAdapter(adapter)
      container.addView(s)
      
      if elem.label and elem.label:match("gender") then
        genderSpinner = s
      elseif elem.label and elem.label:match("send feedback via") then
        mediumSpinner = s
      end
    elseif elem.type == "togglebutton" then
      local b = Button(service)
      local opts = {}
      for opt in string.gmatch(elem.options or "", "[^,]+") do
        local trimmed = opt:match("^%s*(.-)%s*$")
        if trimmed ~= "" then table.insert(opts, trimmed) end
      end
      if #opts == 0 then table.insert(opts, "Option 1") end
      local idx = 1
      b.setText(opts[idx])
      b.setOnClickListener(function()
        idx = (idx % #opts) + 1
        b.setText(opts[idx])
      end)
      container.addView(b)
    end
  end
  dlg.setOnKeyListener(DialogInterface.OnKeyListener{
    onKey = function(dialog, keyCode, event)
      if keyCode == KeyEvent.KEYCODE_BACK and event.getAction() == KeyEvent.ACTION_UP then
        if #navStack > 1 then
          table.remove(navStack)
          local prevId = navStack[#navStack]
          table.remove(navStack)
          showScreen(prevId, false)
        else
          if dlg then dlg.dismiss() end
        end
        return true
      end
      return false
    end
  })
  dlg.show()
end

local loadingLayout = {
  LinearLayout,
  orientation = "vertical",
  layout_width = "fill",
  layout_height = "fill",
  backgroundColor = Color.parseColor("#121212"),
  gravity = Gravity.CENTER,
  padding = "16dp",
  {
    ProgressBar,
    layout_width = "wrap",
    layout_height = "wrap",
    indeterminate = true,
  },
  {
    TextView,
    text = "Loading application...",
    textColor = Color.WHITE,
    textSize = 18,
    gravity = Gravity.CENTER,
    layout_marginTop = "16dp",
  }
}

local loadingDlg = LuaDialog(service)
loadingDlg.View = loadlayout(loadingLayout)
loadingDlg.setCancelable(false)
loadingDlg.show()

Handler().postDelayed(Runnable({
  run = function()
    if loadingDlg then
      loadingDlg.dismiss()
    end
    showScreen(1, false)
  end
}), 1500)